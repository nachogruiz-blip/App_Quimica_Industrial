{
  // Comprobación de tipos sin build: VS Code la usa al editar y la CI la ejecuta (tsc -p jsconfig.json).
  // Revisa los datos de las unidades contra tipos.d.ts. No se publica (.assetsignore).
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false
  },
  "files": ["tipos.d.ts", "js/utilidades.js", "datos/registro.js", "datos/novedades.js"],
  "include": ["datos/*_ud*.js"]
}
